# WashData .gitignore. What is committed: the integration, its tests, the dev tools
# and the public docs. Everything below is local, generated or private.

# --- Python / Node / editors -------------------------------------------------
__pycache__/
*.py[cod]
.venv/
.venv_*/
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.ruff_cache/
.mypy_cache/
node_modules/
.vscode/
*.code-workspace
.DS_Store
*.log
bin/

# --- Test and E2E output -----------------------------------------------------
test-results/
playwright-tests/test-results/
playwright-tests/playwright-report/

# --- Private data: cycle corpora, exports, dumps, secrets ----------------------
# The maintainer's and users' recorded cycles (gitignored corpus the slow tests
# and devtools harnesses read when present).
cycle_data/
mock_data/
backups/
*.dump
devtools/secrets.py
devtools/priv_secrets.py
gha-creds-*.json
.env
.mcp.json

# --- Internal documentation and agent working files (local only) --------------
# The engineering reference, the tech-debt register, plans and reply drafts live
# under docs/internal/ on the maintainer's machine only.
docs/internal/
docs/plans/
docs/superpowers/
docs/STORE.md
.dev_notes/
.claude/
.agent/
.gemini/
.issues/
conductor/
IMPROVEMENT_PLAN.md
ROADMAP.md
coderabbit_unfixed_findings.md
reddit_post_draft.md
*_reply_draft.md
*_REPLY.md
UI_TEST_GUIDE_*.md
.github/agents
.github/commands/
.github/rules
.github/scripts
.github/skills
.github/ui-ux-pro-max
.github/workflows copy
.github/ARCHITECTURE.md

# --- Dev tool state ------------------------------------------------------------
deploy_to_ha.sh
devtools/mock_socket.db
devtools/mock_socket_config.json
devtools/mock_socket_config.tmp
devtools/mock_socket_ledger.jsonl
devtools/mock_socket_history/
devtools/uploaded_cycles
devtools/.mock_socket.pid
devtools/generate_docs_graphs.py
custom_components/ha_washdata/test_data
tests/repro/data_files.txt
re/SETUP.md

# The test box's generated Home Assistant config dir (.storage, recorder DB, logs,
# token, captured notifications). The scripts that build the box are committed.
devtools/testbox/config/

# --- Generated at runtime, never committed --------------------------------------
# Pre-compressed static assets are built at integration setup from the file being
# served (frontend._ensure_gzip): a checked-in .gz could out-live its source.
custom_components/ha_washdata/www/*.gz
custom_components/ha_washdata/translations/panel/*.gz
